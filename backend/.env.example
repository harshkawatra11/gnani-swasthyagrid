# Gemini (AI Studio) — the live LLM fallback (and the typed Ask endpoint's only provider).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only used by the voice/briefing LLM router, via Gemini's OpenAI-compatible endpoint.
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_CHAT_MODEL=
GEMINI_REASONING_EFFORT=minimal

# GCP (optional, only needed once deployed — see docs/09-gcp-deployment.md)
USE_VERTEX_AI=false
USE_SECRET_MANAGER=false
GOOGLE_CLOUD_PROJECT=

# Gnani.ai voice (Vachana API): Prisma STT and Timbre TTS share one key.
# Grounds spoken questions in the same district/facility tools the typed Ask endpoint uses.
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v2.5
GNANI_STT_FORMAT=transcribe
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE_EN=Kaveri
GNANI_TTS_VOICE_HI=Nalini
GNANI_TTS_MODE=ws

# LLM router: Evon v3.3 is primary whenever EVON_BASE_URL is set, else Gemini answers.
LLM_PRIMARY=evon
LLM_STREAM_WITH_TOOLS=true
# set to a vLLM/SGLang/HF Endpoint /v1 URL serving gnani/gnani-evon-v3.3
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani-evon-v3.3

# Deployed frontend origins this backend should accept (CORS + the voice WebSocket
# origin check). JSON list, e.g. ["https://gnani-swasthyagrid.vercel.app"].
FRONTEND_ORIGINS=[]

# Data source: auto (Firestore when reachable, else seed JSON), seed, or firestore.
DATA_SOURCE=auto
# Base64 or raw service-account JSON (same format the CRM uses), or a file path.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Supply chain simulation (simulated seconds per real second; 1 = real time).
LOGISTICS_TIME_SCALE=60
LOGISTICS_SCENARIO_START=
LOGISTICS_AUTO_POD_MINUTES=240
LOGISTICS_BACKGROUND_TRAFFIC=true
LOGISTICS_TICK=true
LOGISTICS_ADMIN_ENABLED=true
# Shared secret with the CRM for proof-of-delivery calls. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LOGISTICS_SERVICE_TOKEN=
LOGISTICS_STATE_PATH=.runtime/logistics_state.json

ENVIRONMENT=local
